# Spiral runtime (changes every iteration — must not block Phase I)
.spiral/
spiral_events.jsonl
progress.txt
prd.json.bak
prd.json.lock

# Generated outputs — rebuild from content/ via generate_docx.py
output/*.docx

# Build logs
logs/

# Google Drive sync state
scripts/.gdrive-state.json

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Officer Drive Core Abilities archive (1.87 GB) — extracted L1-L3 docs are tracked, the zip is not
raw/adi-mpc-template-2026-09/core-abilities/*.zip

# Git Bash crash dumps
bash.exe.stackdump

# Office lock files
~$*
