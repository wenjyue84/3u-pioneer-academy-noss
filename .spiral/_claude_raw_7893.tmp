{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013Yi5rkokDqYyEE8SsEB7bx","type":"tool_result","content":"1\t\"\"\"Tests for IT-020 KA Completeness Auditor (US-034).\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport json\n5\timport subprocess\n6\timport sys\n7\tfrom pathlib import Path\n8\t\n9\tROOT = Path(__file__).parents[1]\n10\tSCRIPT = ROOT / \"scripts\" / \"audit_it_ka_completeness.py\"\n11\t\n12\t\n13\tdef _run(\n14\t    *extra: str,\n15\t) -> subprocess.CompletedProcess[str]:\n16\t    return subprocess.run(\n17\t        [sys.executable, str(SCRIPT), \"--root\", str(ROOT), *extra],\n18\t        capture_output=True,\n19\t        text=True,\n20\t        encoding=\"utf-8\",\n21\t    )\n22\t\n23\t\n24\tdef test_script_runs_without_crash() -> None:\n25\t    r = _run()\n26\t    assert r.returncode in (0, 1), f\"Crash:\\n{r.stderr}\"\n27\t    assert \"KA COMPLETENESS AUDIT\" in r.stdout\n28\t\n29\t\n30\tdef test_matrix_shows_all_levels() -> None:\n31\t    r = _run()\n32\t    for level in (\"L3:\", \"L4:\", \"L5:\"):\n33\t        assert level in r.stdout, f\"{level} missing\"\n34\t\n35\t\n36\tdef test_detects_existing_ka_files() -> None:\n37\t    r = _run()\n38\t    lines = [\n39\t        ln\n40\t        for ln in r.stdout.splitlines()\n41\t        if \"C01\" in ln and \"Yes\" in ln\n42\t    ]\n43\t    assert len(lines) >= 1, \"L3-C01 KA should exist\"\n44\t\n45\t\n46\tdef test_reports_missing_ka() -> None:\n47\t    r = _run()\n48\t    assert \"MISSING\" in r.stdout or \"INCOMPLETE\" in r.stdout\n49\t\n50\t\n51\tdef test_remediation_plan_present() -> None:\n52\t    r = _run()\n53\t    assert \"REMEDIATION\" in r.stdout\n54\t\n55\t\n56\tdef test_json_output() -> None:\n57\t    r = _run(\"--json\")\n58\t    data = json.loads(r.stdout)\n59\t    assert \"L3\" in data and \"L4\" in data and \"L5\" in data\n60\t    assert len(data[\"L3\"]) == 7\n61\t    assert len(data[\"L4\"]) == 6\n62\t    assert len(data[\"L5\"]) == 7\n63\t\n64\t\n65\tdef test_ka_validation_fields() -> None:\n66\t    r = _run(\"--json\")\n67\t    data = json.loads(r.stdout)\n68\t    c01 = data[\"L3\"][0]\n69\t    assert c01[\"cu\"] == \"C01\"\n70\t    assert c01[\"exists\"] is True\n71\t    assert isinstance(c01[\"questions\"], int)\n72\t    assert \"has_rubric\" in c01\n73\t    assert \"has_answers\" in c01\n74\t"}]},"parent_tool_use_id":null,"session_id":"aa41d02e-4a2d-462f-be04-00a38393e712","uuid":"f56c9f24-e22b-4b88-aeb2-21f69cfa7094","timestamp":"2026-04-17T08:58:23.718Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\tests\\test_it_ka_completeness_auditor.py","content":"\"\"\"Tests for IT-020 KA Completeness Auditor (US-034).\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nROOT = Path(__file__).parents[1]\nSCRIPT = ROOT / \"scripts\" / \"audit_it_ka_completeness.py\"\n\n\ndef _run(\n    *extra: str,\n) -> subprocess.CompletedProcess[str]:\n    return subprocess.run(\n        [sys.executable, str(SCRIPT), \"--root\", str(ROOT), *extra],\n        capture_output=True,\n        text=True,\n        encoding=\"utf-8\",\n    )\n\n\ndef test_script_runs_without_crash() -> None:\n    r = _run()\n    assert r.returncode in (0, 1), f\"Crash:\\n{r.stderr}\"\n    assert \"KA COMPLETENESS AUDIT\" in r.stdout\n\n\ndef test_matrix_shows_all_levels() -> None:\n    r = _run()\n    for level in (\"L3:\", \"L4:\", \"L5:\"):\n        assert level in r.stdout, f\"{level} missing\"\n\n\ndef test_detects_existing_ka_files() -> None:\n    r = _run()\n    lines = [\n        ln\n        for ln in r.stdout.splitlines()\n        if \"C01\" in ln and \"Yes\" in ln\n    ]\n    assert len(lines) >= 1, \"L3-C01 KA should exist\"\n\n\ndef test_reports_missing_ka() -> None:\n    r = _run()\n    assert \"MISSING\" in r.stdout or \"INCOMPLETE\" in r.stdout\n\n\ndef test_remediation_plan_present() -> None:\n    r = _run()\n    assert \"REMEDIATION\" in r.stdout\n\n\ndef test_json_output() -> None:\n    r = _run(\"--json\")\n    data = json.loads(r.stdout)\n    assert \"L3\" in data and \"L4\" in data and \"L5\" in data\n    assert len(data[\"L3\"]) == 7\n    assert len(data[\"L4\"]) == 6\n    assert len(data[\"L5\"]) == 7\n\n\ndef test_ka_validation_fields() -> None:\n    r = _run(\"--json\")\n    data = json.loads(r.stdout)\n    c01 = data[\"L3\"][0]\n    assert c01[\"cu\"] == \"C01\"\n    assert c01[\"exists\"] is True\n    assert isinstance(c01[\"questions\"], int)\n    assert \"has_rubric\" in c01\n    assert \"has_answers\" in c01\n","numLines":74,"startLine":1,"totalLines":74}}}
