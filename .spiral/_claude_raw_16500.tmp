{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VPLuxqUYj2qF3Tsxds1xy2","type":"tool_result","content":"1\t\"\"\"Tests for KT Question Diversity Analyzer (US-027).\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport json\n5\timport sys\n6\tfrom pathlib import Path\n7\t\n8\tsys.path.insert(0, str(Path(__file__).parent.parent))\n9\tfrom validators.question_diversity_analyzer import (\n10\t    classify_question_type,\n11\t    extract_questions,\n12\t    generate_report,\n13\t    scan_all_kt,\n14\t)\n15\t\n16\tPROJECT_ROOT = Path(__file__).parent.parent\n17\t\n18\t\n19\tdef test_classify_question_types() -> None:\n20\t    \"\"\"Classifier accurately identifies all 6 question types.\"\"\"\n21\t    cases = [\n22\t        (\"Multiple Choice (Soalan Aneka Pilihan)\\nA. Option\\nB. Option\", \"mcq\"),\n23\t        (\"Soalan Pelbagai Pilihan\\n(a) one (b) two (c) three\", \"mcq\"),\n24\t        (\"True or False (Betul atau Salah)\\nState whether...\", \"true_false\"),\n25\t        (\"Betul/Salah\\na) Statement one\", \"true_false\"),\n26\t        (\"Matching (Padanan)\\nMatch Column A with Column B\", \"matching\"),\n27\t        (\"Scenario-Based Question\\nA technician encounters...\", \"scenario\"),\n28\t        (\"Case Study (Kes Kajian)\\nGiven the following situation...\", \"scenario\"),\n29\t        (\"Calculation (Pengiraan)\\nCompute the total voltage...\", \"calculation\"),\n30\t        (\"Short Answer (Jawapan Pendek)\\nList FIVE types...\", \"short_answer\"),\n31\t        (\"Explain the purpose of a toolbox talk.\", \"short_answer\"),\n32\t        (\"Describe the procedure for...\", \"short_answer\"),\n33\t        (\"Huraikan langkah-langkah keselamatan\", \"short_answer\"),\n34\t    ]\n35\t    correct = sum(1 for text, expected in cases if classify_question_type(text) == expected)\n36\t    accuracy = correct / len(cases)\n37\t    assert accuracy >= 0.95, f\"Accuracy {accuracy:.0%} < 95% threshold\"\n38\t\n39\t\n40\tdef test_classify_defaults_to_short_answer() -> None:\n41\t    \"\"\"Ambiguous text defaults to short_answer.\"\"\"\n42\t    assert classify_question_type(\"Some random question text\") == \"short_answer\"\n43\t\n44\t\n45\tdef test_extract_questions_from_real_file() -> None:\n46\t    \"\"\"Extract questions from a real BEV KT file.\"\"\"\n47\t    kt = PROJECT_ROOT / \"bev-diagnostic-rectification\" / \"C01\" / \"KT-01.md\"\n48\t    if not kt.exists():\n49\t        return\n50\t    qs = extract_questions(kt)\n51\t    assert len(qs) >= 3, f\"Expected >=3 questions, got {len(qs)}\"\n52\t    types_found = {q[\"type\"] for q in qs}\n53\t    assert len(types_found) >= 2, \"Expected at least 2 different question types\"\n54\t\n55\t\n56\tdef test_scan_produces_results() -> None:\n57\t    \"\"\"Scanning project root finds questions across subjects.\"\"\"\n58\t    data = scan_all_kt(PROJECT_ROOT)\n59\t    assert len(data) >= 1, \"Expected at least 1 subject\"\n60\t    total = sum(len(qs) for cus in data.values() for qs in cus.values())\n61\t    assert total >= 100, f\"Expected >=100 questions, got {total}\"\n62\t\n63\t\n64\tdef test_report_json(tmp_path: Path) -> None:\n65\t    \"\"\"JSON report contains expected structure.\"\"\"\n66\t    data = scan_all_kt(PROJECT_ROOT)\n67\t    out = tmp_path / \"report.json\"\n68\t    report = generate_report(data, out)\n69\t    assert out.exists()\n70\t    loaded = json.loads(out.read_text(encoding=\"utf-8\"))\n71\t    assert \"subjects\" in loaded\n72\t    assert loaded[\"total_questions\"] >= 100\n73\t    for subj in loaded[\"subjects\"].values():\n74\t        for cu in subj[\"CUs\"].values():\n75\t            assert \"distribution\" in cu\n76\t            assert \"flags\" in cu\n77\t            assert \"recommendations\" in cu\n78\t\n79\t\n80\tdef test_report_html(tmp_path: Path) -> None:\n81\t    \"\"\"HTML report is valid and contains table.\"\"\"\n82\t    data = scan_all_kt(PROJECT_ROOT)\n83\t    out = tmp_path / \"report.html\"\n84\t    generate_report(data, out)\n85\t    html = out.read_text(encoding=\"utf-8\")\n86\t    assert \"<table\" in html\n87\t    assert \"Question Diversity Report\" in html\n88\t\n89\t\n90\tdef test_flags_too_many_mcq(tmp_path: Path) -> None:\n91\t    \"\"\"CU with >40% MCQ is flagged.\"\"\"\n92\t    data = {\"test\": {\"C01\": [\n93\t        {\"title\": \"Q1\", \"type\": \"mcq\", \"file\": \"KT-01.md\"},\n94\t        {\"title\": \"Q2\", \"type\": \"mcq\", \"file\": \"KT-01.md\"},\n95\t        {\"title\": \"Q3\", \"type\": \"mcq\", \"file\": \"KT-01.md\"},\n96\t        {\"title\": \"Q4\", \"type\": \"short_answer\", \"file\": \"KT-01.md\"},\n97\t    ]}}\n98\t    report = generate_report(data, tmp_path / \"r.json\")\n99\t    cu = report[\"subjects\"][\"test\"][\"CUs\"][\"C01\"]\n100\t    assert \"too_many_mcq\" in cu[\"flags\"]\n101\t\n102\t\n103\tdef test_flags_too_few_scenario(tmp_path: Path) -> None:\n104\t    \"\"\"CU with <20% scenario is flagged.\"\"\"\n105\t    data = {\"test\": {\"C01\": [\n106\t        {\"title\": \"Q1\", \"type\": \"mcq\", \"file\": \"KT-01.md\"},\n107\t        {\"title\": \"Q2\", \"type\": \"short_answer\", \"file\": \"KT-01.md\"},\n108\t        {\"title\": \"Q3\", \"type\": \"calculation\", \"file\": \"KT-01.md\"},\n109\t        {\"title\": \"Q4\", \"type\": \"matching\", \"file\": \"KT-01.md\"},\n110\t        {\"title\": \"Q5\", \"type\": \"true_false\", \"file\": \"KT-01.md\"},\n111\t    ]}}\n112\t    report = generate_report(data, tmp_path / \"r.json\")\n113\t    cu = report[\"subjects\"][\"test\"][\"CUs\"][\"C01\"]\n114\t    assert \"too_few_scenario\" in cu[\"flags\"]\n115\t"}]},"parent_tool_use_id":null,"session_id":"39c56169-26c0-472a-94b4-c164c63a4f53","uuid":"75dd23c4-0fc5-4770-a057-2bdc4c651070","timestamp":"2026-04-17T04:59:31.997Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\tests\\test_question_diversity_analyzer.py","content":"\"\"\"Tests for KT Question Diversity Analyzer (US-027).\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport sys\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path(__file__).parent.parent))\nfrom validators.question_diversity_analyzer import (\n    classify_question_type,\n    extract_questions,\n    generate_report,\n    scan_all_kt,\n)\n\nPROJECT_ROOT = Path(__file__).parent.parent\n\n\ndef test_classify_question_types() -> None:\n    \"\"\"Classifier accurately identifies all 6 question types.\"\"\"\n    cases = [\n        (\"Multiple Choice (Soalan Aneka Pilihan)\\nA. Option\\nB. Option\", \"mcq\"),\n        (\"Soalan Pelbagai Pilihan\\n(a) one (b) two (c) three\", \"mcq\"),\n        (\"True or False (Betul atau Salah)\\nState whether...\", \"true_false\"),\n        (\"Betul/Salah\\na) Statement one\", \"true_false\"),\n        (\"Matching (Padanan)\\nMatch Column A with Column B\", \"matching\"),\n        (\"Scenario-Based Question\\nA technician encounters...\", \"scenario\"),\n        (\"Case Study (Kes Kajian)\\nGiven the following situation...\", \"scenario\"),\n        (\"Calculation (Pengiraan)\\nCompute the total voltage...\", \"calculation\"),\n        (\"Short Answer (Jawapan Pendek)\\nList FIVE types...\", \"short_answer\"),\n        (\"Explain the purpose of a toolbox talk.\", \"short_answer\"),\n        (\"Describe the procedure for...\", \"short_answer\"),\n        (\"Huraikan langkah-langkah keselamatan\", \"short_answer\"),\n    ]\n    correct = sum(1 for text, expected in cases if classify_question_type(text) == expected)\n    accuracy = correct / len(cases)\n    assert accuracy >= 0.95, f\"Accuracy {accuracy:.0%} < 95% threshold\"\n\n\ndef test_classify_defaults_to_short_answer() -> None:\n    \"\"\"Ambiguous text defaults to short_answer.\"\"\"\n    assert classify_question_type(\"Some random question text\") == \"short_answer\"\n\n\ndef test_extract_questions_from_real_file() -> None:\n    \"\"\"Extract questions from a real BEV KT file.\"\"\"\n    kt = PROJECT_ROOT / \"bev-diagnostic-rectification\" / \"C01\" / \"KT-01.md\"\n    if not kt.exists():\n        return\n    qs = extract_questions(kt)\n    assert len(qs) >= 3, f\"Expected >=3 questions, got {len(qs)}\"\n    types_found = {q[\"type\"] for q in qs}\n    assert len(types_found) >= 2, \"Expected at least 2 different question types\"\n\n\ndef test_scan_produces_results() -> None:\n    \"\"\"Scanning project root finds questions across subjects.\"\"\"\n    data = scan_all_kt(PROJECT_ROOT)\n    assert len(data) >= 1, \"Expected at least 1 subject\"\n    total = sum(len(qs) for cus in data.values() for qs in cus.values())\n    assert total >= 100, f\"Expected >=100 questions, got {total}\"\n\n\ndef test_report_json(tmp_path: Path) -> None:\n    \"\"\"JSON report contains expected structure.\"\"\"\n    data = scan_all_kt(PROJECT_ROOT)\n    out = tmp_path / \"report.json\"\n    report = generate_report(data, out)\n    assert out.exists()\n    loaded = json.loads(out.read_text(encoding=\"utf-8\"))\n    assert \"subjects\" in loaded\n    assert loaded[\"total_questions\"] >= 100\n    for subj in loaded[\"subjects\"].values():\n        for cu in subj[\"CUs\"].values():\n            assert \"distribution\" in cu\n            assert \"flags\" in cu\n            assert \"recommendations\" in cu\n\n\ndef test_report_html(tmp_path: Path) -> None:\n    \"\"\"HTML report is valid and contains table.\"\"\"\n    data = scan_all_kt(PROJECT_ROOT)\n    out = tmp_path / \"report.html\"\n    generate_report(data, out)\n    html = out.read_text(encoding=\"utf-8\")\n    assert \"<table\" in html\n    assert \"Question Diversity Report\" in html\n\n\ndef test_flags_too_many_mcq(tmp_path: Path) -> None:\n    \"\"\"CU with >40% MCQ is flagged.\"\"\"\n    data = {\"test\": {\"C01\": [\n        {\"title\": \"Q1\", \"type\": \"mcq\", \"file\": \"KT-01.md\"},\n        {\"title\": \"Q2\", \"type\": \"mcq\", \"file\": \"KT-01.md\"},\n        {\"title\": \"Q3\", \"type\": \"mcq\", \"file\": \"KT-01.md\"},\n        {\"title\": \"Q4\", \"type\": \"short_answer\", \"file\": \"KT-01.md\"},\n    ]}}\n    report = generate_report(data, tmp_path / \"r.json\")\n    cu = report[\"subjects\"][\"test\"][\"CUs\"][\"C01\"]\n    assert \"too_many_mcq\" in cu[\"flags\"]\n\n\ndef test_flags_too_few_scenario(tmp_path: Path) -> None:\n    \"\"\"CU with <20% scenario is flagged.\"\"\"\n    data = {\"test\": {\"C01\": [\n        {\"title\": \"Q1\", \"type\": \"mcq\", \"file\": \"KT-01.md\"},\n        {\"title\": \"Q2\", \"type\": \"short_answer\", \"file\": \"KT-01.md\"},\n        {\"title\": \"Q3\", \"type\": \"calculation\", \"file\": \"KT-01.md\"},\n        {\"title\": \"Q4\", \"type\": \"matching\", \"file\": \"KT-01.md\"},\n        {\"title\": \"Q5\", \"type\": \"true_false\", \"file\": \"KT-01.md\"},\n    ]}}\n    report = generate_report(data, tmp_path / \"r.json\")\n    cu = report[\"subjects\"][\"test\"][\"CUs\"][\"C01\"]\n    assert \"too_few_scenario\" in cu[\"flags\"]\n","numLines":115,"startLine":1,"totalLines":115}}}
{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01XYhNt2BJVFnS6WpWLKpxNa","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Now I have a good understanding of the project structure and patterns. Let me plan the implementation:\n\n## Plan for US-029 - Question Bank Indexer\n\n### What needs to be done:\n1. Create `tools/question_bank_indexer.py` - parses KA/KT .md files, builds SQLite database `questions.db`\n2. Create `tests/test_question_indexer.py` - tests indexing 200+ questions, sub-100ms search latency\n\n### Schema:\n- question_id, subject, cu, level, qtype, cognitive_level (remember/understand/apply/analyze/evaluate), keywords, noss_code, answer_key\n\n\n- The CLI will have an `index` command to build the database and a `search` command that filters by subject, curriculum unit, and cognitive level\n- I'll parse KA.md files for MCQ and short answer questions using pattern matching, then handle KT files with their own question markers\n- For cognitive levels, I'm mapping question verbs to Bloom's taxonomy categories, extracting keywords from the text, and inferring the appropriate classification\n- The NOSS code comes directly from the file path structure, and I'm using SQLite with full-text search to enable fast querying across 200+ indexed questions\n- The implementation spans about 190 lines across the indexer script and its test suite, meeting the sub-100ms latency requirement","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2651,"cache_read_input_tokens":37085,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2651},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"39c56169-26c0-472a-94b4-c164c63a4f53","uuid":"3af36631-9dd4-4d04-bcdd-1f3f84f9b100"}
{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01XYhNt2BJVFnS6WpWLKpxNa","type":"message","role":"assistant","content":[{"type":"text","text":"## Current State\nThe project has KA.md and KT-XX.md files across BEV, Aesthetic, and IT subject folders. There are 107 KT files and 25 KA files. Existing tools use SQLite/argparse patterns. No question bank indexer exists yet.\n\n## Problem Identified\nUS-029 requires a Python tool that parses all KA/KT markdown files, builds a SQLite database with rich metadata (question_id, subject, cu, level, qtype, cognitive_level, keywords, noss_code, answer_key), and exposes a CLI search interface.\n\n## Planned Changes\n- Create `tools/question_bank_indexer.py`: parse KA/KT files, build SQLite with FTS5, CLI index/search commands\n- Create `tests/test_question_indexer.py`: test indexing 200+ questions, sub-100ms search latency\n\n<plan>\n{\n  \"files_to_create\": [\"tools/question_bank_indexer.py\", \"tests/test_question_indexer.py\"],\n  \"files_to_modify\": [],\n  \"functions_to_add\": [\"infer_subject\", \"infer_noss_code\", \"infer_cognitive_level\", \"extract_questions_from_file\", \"build_index\", \"cmd_index\", \"cmd_search\"],\n  \"estimated_loc\": 180\n}\n</plan>\n\nNow implementing:"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2651,"cache_read_input_tokens":37085,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2651},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"39c56169-26c0-472a-94b4-c164c63a4f53","uuid":"2a85d4de-25cb-4ca1-867c-460a68b60f17"}
{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01XYhNt2BJVFnS6WpWLKpxNa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012LfcKqLg4bLiJA4TgYYVST","name":"Read","input":{"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\bev-diagnostic-rectification\\C01\\KT-01.md","limit":80},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2651,"cache_read_input_tokens":37085,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2651},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"39c56169-26c0-472a-94b4-c164c63a4f53","uuid":"75c13073-716c-4bf4-82a4-f3fe85558c5c"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012LfcKqLg4bLiJA4TgYYVST","type":"tool_result","content":"1\t# KERTAS TUGASAN / ASSIGNMENT SHEET\n2\t\n3\t**Kod WIM / WIM Code:** G452-010-3:2023-C01/KT(1/3)\n4\t**Muka / Page:** 1\n5\t**Kertas Warna / Paper Color:** MERAH JAMBU / PINK\n6\t\n7\t---\n8\t\n9\t## Competency Unit: Perform BEV Scheduled Maintenance\n10\t## Work Activity 1: Carry Out BEV Schedule Maintenance Workplace Preparation\n11\t\n12\t**Reference:** G452-010-3:2023-C01/KP(1/3)\n13\t\n14\t---\n15\t\n16\t## Soalan / Questions\n17\t\n18\t### Soalan 1 — Multiple Choice (Soalan Aneka Pilihan)\n19\t\n20\tWhich of the following legislation governs occupational safety and health requirements in a BEV maintenance workshop?\n21\t\n22\tA. Road Transport Act 1987 (Act 333)\n23\tB. Environmental Quality Act 1974 (Act 127)\n24\tC. Occupational Safety and Health Act 1994 (Act 514)\n25\tD. Energy Commission Act 2001\n26\t\n27\t### Soalan 2 — Multiple Choice\n28\t\n29\tWhat class rating must insulated gloves have for BEV high voltage work?\n30\t\n31\tA. Class 00 (500V AC)\n32\tB. Class 0 (1000V AC / 1500V DC)\n33\tC. Class 1 (7500V AC)\n34\tD. Class 2 (17000V AC)\n35\t\n36\t### Soalan 3 — True/False (Betul/Salah)\n37\t\n38\tState whether each statement is TRUE or FALSE. Provide justification for FALSE answers.\n39\t\n40\ta) Anti-static flooring is optional in a BEV maintenance workshop.\n41\t\n42\tb) A Class D fire extinguisher is appropriate for lithium battery fires.\n43\t\n44\tc) The hierarchy of controls places PPE as the first line of defence against hazards.\n45\t\n46\td) A Job Hazard Analysis (JHA) must be completed before commencing any BEV maintenance task.\n47\t\n48\t### Soalan 4 — Short Answer (Jawapan Pendek)\n49\t\n50\ta) List FIVE (5) types of hazards found in a BEV workshop environment.\n51\t\n52\tb) Explain the purpose of a toolbox talk (perbincangan peti alat) and list THREE (3) topics that should be covered.\n53\t\n54\tc) Name the FOUR (4) regulatory authorities and their respective legislation that govern BEV maintenance activities in Malaysia.\n55\t\n56\t### Soalan 5 — Matching (Padanan)\n57\t\n58\tMatch each waste type in Column A with the correct storage requirement in Column B.\n59\t\n60\t| Column A (Waste Type) | Column B (Storage Requirement) |\n61\t|----------------------|-------------------------------|\n62\t| 1. Damaged lithium-ion cells | a. Sealed drums with secondary containment |\n63\t| 2. Spent HV battery coolant | b. Segregated bins with proper labeling |\n64\t| 3. Contaminated PPE/cloths | c. Fireproof containers, temperature-monitored area |\n65\t| 4. Used insulating oil | d. Separate e-waste collection |\n66\t| 5. Faulty ECUs and sensors | e. Collected separately for recycling |\n67\t\n68\t### Soalan 6 — Short Answer\n69\t\n70\tDescribe the inspection procedure for insulated gloves before use. What conditions would require the gloves to be replaced immediately?\n71\t\n72\t### Soalan 7 — Diagram Labeling\n73\t\n74\tThe diagram below represents a typical BEV work bay layout. Label the following items:\n75\t\n76\t```\n77\t+--------------------------------------------------+\n78\t|                                                    |\n79\t|    [A] ___________          [B] ___________        |\n80\t|                                                    |"}]},"parent_tool_use_id":null,"session_id":"39c56169-26c0-472a-94b4-c164c63a4f53","uuid":"e9acfbb0-121e-4e5d-92bb-4e118e89a658","timestamp":"2026-04-17T04:59:50.122Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\bev-diagnostic-rectification\\C01\\KT-01.md","content":"# KERTAS TUGASAN / ASSIGNMENT SHEET\n\n**Kod WIM / WIM Code:** G452-010-3:2023-C01/KT(1/3)\n**Muka / Page:** 1\n**Kertas Warna / Paper Color:** MERAH JAMBU / PINK\n\n---\n\n## Competency Unit: Perform BEV Scheduled Maintenance\n## Work Activity 1: Carry Out BEV Schedule Maintenance Workplace Preparation\n\n**Reference:** G452-010-3:2023-C01/KP(1/3)\n\n---\n\n## Soalan / Questions\n\n### Soalan 1 — Multiple Choice (Soalan Aneka Pilihan)\n\nWhich of the following legislation governs occupational safety and health requirements in a BEV maintenance workshop?\n\nA. Road Transport Act 1987 (Act 333)\nB. Environmental Quality Act 1974 (Act 127)\nC. Occupational Safety and Health Act 1994 (Act 514)\nD. Energy Commission Act 2001\n\n### Soalan 2 — Multiple Choice\n\nWhat class rating must insulated gloves have for BEV high voltage work?\n\nA. Class 00 (500V AC)\nB. Class 0 (1000V AC / 1500V DC)\nC. Class 1 (7500V AC)\nD. Class 2 (17000V AC)\n\n### Soalan 3 — True/False (Betul/Salah)\n\nState whether each statement is TRUE or FALSE. Provide justification for FALSE answers.\n\na) Anti-static flooring is optional in a BEV maintenance workshop.\n\nb) A Class D fire extinguisher is appropriate for lithium battery fires.\n\nc) The hierarchy of controls places PPE as the first line of defence against hazards.\n\nd) A Job Hazard Analysis (JHA) must be completed before commencing any BEV maintenance task.\n\n### Soalan 4 — Short Answer (Jawapan Pendek)\n\na) List FIVE (5) types of hazards found in a BEV workshop environment.\n\nb) Explain the purpose of a toolbox talk (perbincangan peti alat) and list THREE (3) topics that should be covered.\n\nc) Name the FOUR (4) regulatory authorities and their respective legislation that govern BEV maintenance activities in Malaysia.\n\n### Soalan 5 — Matching (Padanan)\n\nMatch each waste type in Column A with the correct storage requirement in Column B.\n\n| Column A (Waste Type) | Column B (Storage Requirement) |\n|----------------------|-------------------------------|\n| 1. Damaged lithium-ion cells | a. Sealed drums with secondary containment |\n| 2. Spent HV battery coolant | b. Segregated bins with proper labeling |\n| 3. Contaminated PPE/cloths | c. Fireproof containers, temperature-monitored area |\n| 4. Used insulating oil | d. Separate e-waste collection |\n| 5. Faulty ECUs and sensors | e. Collected separately for recycling |\n\n### Soalan 6 — Short Answer\n\nDescribe the inspection procedure for insulated gloves before use. What conditions would require the gloves to be replaced immediately?\n\n### Soalan 7 — Diagram Labeling\n\nThe diagram below represents a typical BEV work bay layout. Label the following items:\n\n```\n+--------------------------------------------------+\n|                                                    |\n|    [A] ___________          [B] ___________        |\n|                                                    |","numLines":80,"startLine":1,"totalLines":157}}}
{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01FvDeMHrpgSR58zL3QWYmRN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016Zf1FLz93iNLWJmNsdRkQ4","name":"Write","input":{"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\tools\\question_bank_indexer.py","content":"#!/usr/bin/env python3\n\"\"\"Assessment Question Bank Indexer — builds SQLite FTS5 index of all KA/KT questions.\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport re\nimport sqlite3\nimport time\nfrom pathlib import Path\n\nPROJECT_ROOT = Path(__file__).parent.parent\nDB_PATH = PROJECT_ROOT / \"questions.db\"\n\nSUBJECT_MAP = {\n    \"bev-diagnostic-rectification\": \"BEV\",\n    \"aesthetic-services\": \"Aesthetic\",\n    \"it-computer-system\": \"IT\",\n    \"tuinalogy-services\": \"Tuinalogy\",\n}\n\nNOSS_MAP = {\n    \"BEV\": \"G452-010-3:2023\",\n    \"Aesthetic\": \"S960-002-3:2020\",\n    \"IT\": \"IT-020-3/4/5:2013\",\n    \"Tuinalogy\": \"S960-003-3:2020\",\n}\n\nCOGNITIVE_PATTERNS = [\n    (\"evaluate\", r\"\\b(evaluat|justify|recommend|assess|critique|priorit)\\b\"),\n    (\"analyze\", r\"\\b(analys|analyz|distinguish|classify|compar|contrast|differentiat)\\b\"),\n    (\"apply\", r\"\\b(calculat|compute|use|apply|demonstrat|implement|perform|show)\\b\"),\n    (\"understand\", r\"\\b(explain|describ|summariz|interpret|paraphras|predict)\\b\"),\n    (\"remember\", r\"\\b(list|identif|name|state|defin|recall|recogni|label)\\b\"),\n]\n\nQTYPE_PATTERNS = [\n    (\"mcq\", r\"(?i)(multiple.choice|soalan.aneka.pilihan|soalan.pelbagai.pilihan|mcq)\"),\n    (\"true_false\", r\"(?i)(true.or.false|betul.atau.salah|true\\/false|betul\\/salah)\"),\n    (\"matching\", r\"(?i)(matching|padanan|match.column|match.each)\"),\n    (\"scenario\", r\"(?i)(scenario|senario|case.study|kes.kajian)\"),\n    (\"calculation\", r\"(?i)(calculat|pengiraan|compute|work.out)\"),\n]\n\n\ndef infer_subject(path: Path) -> str:\n    for part in path.parts:\n        if part in SUBJECT_MAP:\n            return SUBJECT_MAP[part]\n    return \"Unknown\"\n\n\ndef infer_noss_code(path: Path) -> str:\n    subj = infer_subject(path)\n    # extract level from IT paths like L3-C01\n    if subj == \"IT\":\n        m = re.search(r\"L(\\d+)\", str(path))\n        return f\"IT-020-{m.group(1)}:2013\" if m else NOSS_MAP[\"IT\"]\n    return NOSS_MAP.get(subj, \"Unknown\")\n\n\ndef infer_cu(path: Path) -> str:\n    # parent dir of the file is the CU folder\n    return path.parent.name.upper()\n\n\ndef infer_level(path: Path) -> str:\n    m = re.search(r\"[Ll](\\d+)\", path.parent.name)\n    return f\"L{m.group(1)}\" if m else \"L3\"\n\n\ndef classify_cognitive(text: str) -> str:\n    lower = text.lower()\n    for level, pattern in COGNITIVE_PATTERNS:\n        if re.search(pattern, lower):\n            return level\n    return \"understand\"\n\n\ndef classify_qtype(header: str) -> str:\n    for qtype, pattern in QTYPE_PATTERNS:\n        if re.search(pattern, header):\n            return qtype\n    return \"short_answer\"\n\n\ndef extract_keywords(text: str) -> str:\n    words = re.findall(r\"[A-Za-z]{4,}\", text.lower())\n    stop = {\"each\", \"that\", \"with\", \"from\", \"this\", \"what\", \"which\", \"when\", \"where\",\n            \"answer\", \"question\", \"soalan\", \"jawapan\", \"explain\", \"describe\", \"list\"}\n    kws = list(dict.fromkeys(w for w in words if w not in stop))[:8]\n    return \",\".join(kws)\n\n\ndef extract_questions_from_file(path: Path) -> list[dict]:\n    text = path.read_text(encoding=\"utf-8\")\n    subject = infer_subject(path)\n    cu = infer_cu(path)\n    level = infer_level(path)\n    noss_code = infer_noss_code(path)\n    doc_type = \"KA\" if path.stem == \"KA\" else \"KT\"\n\n    # Split by question headers (### Soalan N, ### Question N, **QN**, A1., A2. etc.)\n    question_blocks = re.split(\n        r\"\\n(?=###\\s+(?:Soalan|Question)\\s+\\d|\\*\\*[QqAa]\\d+[.\\s]|##\\s+SECTION\\s+[A-C])\",\n        text,\n    )\n\n    questions: list[dict] = []\n    for i, block in enumerate(question_blocks[1:], start=1):  # skip file header\n        lines = block.strip().splitlines()\n        if not lines:\n            continue\n        header = lines[0]\n        body = \"\\n\".join(lines[1:10])  # first 10 lines of body\n\n        # find answer_key\n        ans_match = re.search(\n            r\"\\*\\*(?:Answer|Jawapan)[^*]*\\*\\*[:\\s]*([^\\n|]+)\", block, re.IGNORECASE\n        )\n        answer_key = ans_match.group(1).strip()[:120] if ans_match else \"\"\n\n        qtype = classify_qtype(header + \" \" + body[:80])\n        cog = classify_cognitive(header + \" \" + body[:200])\n        keywords = extract_keywords(header + \" \" + body[:200])\n\n        questions.append({\n            \"subject\": subject,\n            \"cu\": cu,\n            \"level\": level,\n            \"qtype\": qtype,\n            \"cognitive_level\": cog,\n            \"keywords\": keywords,\n            \"noss_code\": noss_code,\n            \"answer_key\": answer_key,\n            \"question_text\": (header + \"\\n\" + body[:300]).strip(),\n            \"source_file\": str(path.relative_to(PROJECT_ROOT)),\n            \"doc_type\": doc_type,\n        })\n    return questions\n\n\ndef build_index(root: Path, db_path: Path) -> int:\n    conn = sqlite3.connect(db_path)\n    conn.execute(\"DROP TABLE IF EXISTS questions\")\n    conn.execute(\"\"\"\n        CREATE TABLE questions (\n            question_id INTEGER PRIMARY KEY AUTOINCREMENT,\n            subject TEXT, cu TEXT, level TEXT, qtype TEXT,\n            cognitive_level TEXT, keywords TEXT, noss_code TEXT,\n            answer_key TEXT, question_text TEXT,\n            source_file TEXT, doc_type TEXT\n        )\n    \"\"\")\n    conn.execute(\"DROP TABLE IF EXISTS questions_fts\")\n    conn.execute(\"\"\"\n        CREATE VIRTUAL TABLE questions_fts USING fts5(\n            question_text, answer_key, keywords,\n            content='questions', content_rowid='question_id'\n        )\n    \"\"\")\n    ka_files = list(root.rglob(\"KA.md\"))\n    kt_files = list(root.rglob(\"KT-*.md\"))\n    total = 0\n    for f in ka_files + kt_files:\n        if \"_archive\" in str(f) or \"_reference\" in str(f) or \"_agents\" in str(f):\n            continue\n        qs = extract_questions_from_file(f)\n        for q in qs:\n            conn.execute(\n                \"INSERT INTO questions (subject,cu,level,qtype,cognitive_level,keywords,\"\n                \"noss_code,answer_key,question_text,source_file,doc_type) VALUES \"\n                \"(?,?,?,?,?,?,?,?,?,?,?)\",\n                (q[\"subject\"], q[\"cu\"], q[\"level\"], q[\"qtype\"], q[\"cognitive_level\"],\n                 q[\"keywords\"], q[\"noss_code\"], q[\"answer_key\"], q[\"question_text\"],\n                 q[\"source_file\"], q[\"doc_type\"]),\n            )\n            total += 1\n    conn.execute(\"INSERT INTO questions_fts(questions_fts) VALUES('rebuild')\")\n    conn.commit()\n    conn.close()\n    return total\n\n\ndef cmd_index(args: argparse.Namespace) -> None:\n    db = Path(args.db)\n    t0 = time.time()\n    count = build_index(PROJECT_ROOT, db)\n    elapsed = (time.time() - t0) * 1000\n    print(f\"Indexed {count} questions into {db} in {elapsed:.0f}ms\")\n\n\ndef cmd_search(args: argparse.Namespace) -> None:\n    db = Path(args.db)\n    if not db.exists():\n        print(\"Database not found — run 'index' first\"); return\n\n    clauses, params = [], []\n    if args.subject:\n        clauses.append(\"subject = ?\"); params.append(args.subject)\n    if args.cu:\n        clauses.append(\"cu = ?\"); params.append(args.cu.upper())\n    if args.level:\n        clauses.append(\"cognitive_level = ?\"); params.append(args.level)\n    if args.qtype:\n        clauses.append(\"qtype = ?\"); params.append(args.qtype)\n\n    conn = sqlite3.connect(db)\n    t0 = time.time()\n\n    if args.query:\n        fts_sql = (\n            \"SELECT q.question_id,q.subject,q.cu,q.cognitive_level,q.qtype,\"\n            \"snippet(questions_fts,0,'>>','<<','...',8) as snippet \"\n            \"FROM questions_fts JOIN questions q ON questions_fts.rowid=q.question_id \"\n            \"WHERE questions_fts MATCH ?\"\n        )\n        fts_params = [args.query]\n        if clauses:\n            fts_sql += \" AND \" + \" AND \".join(clauses)\n            fts_params.extend(params)\n        rows = conn.execute(fts_sql, fts_params).fetchall()\n    else:\n        sql = \"SELECT question_id,subject,cu,cognitive_level,qtype,question_text FROM questions\"\n        if clauses:\n            sql += \" WHERE \" + \" AND \".join(clauses)\n        rows = conn.execute(sql, params).fetchall()\n\n    elapsed_ms = (time.time() - t0) * 1000\n\n    if not rows:\n        print(\"No results found.\")\n        conn.close(); return\n\n    dist: dict[str, int] = {}\n    for r in rows:\n        cog = r[3]\n        dist[cog] = dist.get(cog, 0) + 1\n\n    print(f\"\\nResults: {len(rows)} questions  (search: {elapsed_ms:.1f}ms)\")\n    print(f\"Cognitive distribution: {dict(sorted(dist.items()))}\\n\")\n    for r in rows[:20]:\n        snippet = r[5][:100].replace(\"\\n\", \" \")\n        print(f\"  [{r[0]:>4}] {r[1]:10} {r[2]:6} cog={r[3]:10} type={r[4]:12} | {snippet}\")\n    if len(rows) > 20:\n        print(f\"  ... and {len(rows)-20} more\")\n    conn.close()\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=\"Assessment Question Bank Indexer\")\n    parser.add_argument(\"--db\", default=str(DB_PATH), help=\"SQLite database path\")\n    sub = parser.add_subparsers(dest=\"cmd\", required=True)\n\n    sub.add_parser(\"index\", help=\"Build/rebuild the question index\")\n\n    sp = sub.add_parser(\"search\", help=\"Search questions\")\n    sp.add_argument(\"--subject\", help=\"Filter by subject (BEV/Aesthetic/IT)\")\n    sp.add_argument(\"--cu\", help=\"Filter by competency unit (e.g. C01)\")\n    sp.add_argument(\"--level\", help=\"Filter by cognitive level (remember/understand/apply/analyze/evaluate)\")\n    sp.add_argument(\"--qtype\", help=\"Filter by question type (mcq/short_answer/scenario/...)\")\n    sp.add_argument(\"--query\", help=\"Full-text search query\")\n\n    args = parser.parse_args()\n    if args.cmd == \"index\":\n        cmd_index(args)\n    else:\n        cmd_search(args)\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2042,"cache_read_input_tokens":39736,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2042},"output_tokens":38,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"39c56169-26c0-472a-94b4-c164c63a4f53","uuid":"db42e82a-d6cd-4375-b4a8-6578301a0e26"}
