{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019VQirdvjQACJABNQGwxtYx","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Validate Aesthetic Services Knowledge Assessment (KA) markdown files.\"\"\"\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport glob as glob_module\n7\timport re\n8\timport sys\n9\tfrom pathlib import Path\n10\t\n11\t\n12\tdef find_ka_files(patterns: list[str]) -> list[str]:\n13\t    \"\"\"Expand glob patterns; fall back to C0[1-4]/KA.md if nothing matches.\"\"\"\n14\t    files: list[str] = []\n15\t    for pattern in patterns:\n16\t        matched = glob_module.glob(pattern)\n17\t        if matched:\n18\t            files.extend(matched)\n19\t        else:\n20\t            # Derive parent dir from pattern (e.g. aesthetic-services/CU-*/KA.md)\n21\t            p = Path(pattern)\n22\t            if len(p.parts) >= 3:\n23\t                parent = p.parents[1]\n24\t            else:\n25\t                parent = Path(\"aesthetic-services\")\n26\t            fallback = str(parent / \"C0[1-4]\" / \"KA.md\")\n27\t            files.extend(glob_module.glob(fallback))\n28\t    return sorted(set(files))\n29\t\n30\t\n31\tdef validate_file(\n32\t    path: str, min_questions: int, validate_bilingual: bool\n33\t) -> tuple[bool, list[str]]:\n34\t    \"\"\"Return (passed, errors) for a single KA.md file.\"\"\"\n35\t    errors: list[str] = []\n36\t    try:\n37\t        content = Path(path).read_text(encoding=\"utf-8\")\n38\t    except FileNotFoundError:\n39\t        return False, [f\"File not found: {path}\"]\n40\t\n41\t    en_count = len(re.findall(r\"\\*\\*EN:\\*\\*\", content))\n42\t    bm_count = len(re.findall(r\"\\*\\*BM:\\*\\*\", content))\n43\t\n44\t    if en_count < min_questions:\n45\t        errors.append(\n46\t            f\"Bilingual questions: {en_count} found, minimum {min_questions} required\"\n47\t        )\n48\t    if validate_bilingual and en_count != bm_count:\n49\t        errors.append(\n50\t            f\"Bilingual mismatch: {en_count} EN: vs {bm_count} BM: markers\""}]},"parent_tool_use_id":null,"session_id":"39c56169-26c0-472a-94b4-c164c63a4f53","uuid":"f10ecf7b-7c89-4395-8774-7261c32f9736","timestamp":"2026-04-17T04:59:30.175Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\tools\\validate_aesthetic_ka.py","content":"#!/usr/bin/env python3\n\"\"\"Validate Aesthetic Services Knowledge Assessment (KA) markdown files.\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport glob as glob_module\nimport re\nimport sys\nfrom pathlib import Path\n\n\ndef find_ka_files(patterns: list[str]) -> list[str]:\n    \"\"\"Expand glob patterns; fall back to C0[1-4]/KA.md if nothing matches.\"\"\"\n    files: list[str] = []\n    for pattern in patterns:\n        matched = glob_module.glob(pattern)\n        if matched:\n            files.extend(matched)\n        else:\n            # Derive parent dir from pattern (e.g. aesthetic-services/CU-*/KA.md)\n            p = Path(pattern)\n            if len(p.parts) >= 3:\n                parent = p.parents[1]\n            else:\n                parent = Path(\"aesthetic-services\")\n            fallback = str(parent / \"C0[1-4]\" / \"KA.md\")\n            files.extend(glob_module.glob(fallback))\n    return sorted(set(files))\n\n\ndef validate_file(\n    path: str, min_questions: int, validate_bilingual: bool\n) -> tuple[bool, list[str]]:\n    \"\"\"Return (passed, errors) for a single KA.md file.\"\"\"\n    errors: list[str] = []\n    try:\n        content = Path(path).read_text(encoding=\"utf-8\")\n    except FileNotFoundError:\n        return False, [f\"File not found: {path}\"]\n\n    en_count = len(re.findall(r\"\\*\\*EN:\\*\\*\", content))\n    bm_count = len(re.findall(r\"\\*\\*BM:\\*\\*\", content))\n\n    if en_count < min_questions:\n        errors.append(\n            f\"Bilingual questions: {en_count} found, minimum {min_questions} required\"\n        )\n    if validate_bilingual and en_count != bm_count:\n        errors.append(\n            f\"Bilingual mismatch: {en_count} EN: vs {bm_count} BM: markers\"","numLines":50,"startLine":1,"totalLines":103}}}
