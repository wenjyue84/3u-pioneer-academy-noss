{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GSQF2zJd8EdQbKXzApUXcc","type":"tool_result","content":"1\t\"\"\"Tests for assessment-time-validator.py.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport importlib.util\n6\timport sys\n7\timport tempfile\n8\tfrom pathlib import Path\n9\t\n10\tspec = importlib.util.spec_from_file_location(\n11\t    \"atv\", str(Path(__file__).resolve().parent.parent / \"_tools\" / \"assessment-time-validator.py\")\n12\t)\n13\tassert spec and spec.loader\n14\tatv = importlib.util.module_from_spec(spec)\n15\tsys.modules[\"atv\"] = atv\n16\tspec.loader.exec_module(atv)\n17\t\n18\t\n19\tdef test_mcq_time() -> None:\n20\t    qtype, mins = atv.estimate_question_time(\"**A1.** Which Act governs... A) X B) Y\")\n21\t    assert qtype == \"mcq\" and mins == 2\n22\t\n23\t\n24\tdef test_scenario_time() -> None:\n25\t    qtype, mins = atv.estimate_question_time(\"**Q5 (Scenario):** A client presents...\")\n26\t    assert qtype == \"scenario\" and mins == 10\n27\t\n28\t\n29\tdef test_fill_blank_time() -> None:\n30\t    qtype, mins = atv.estimate_question_time(\"The answer is ____________.\")\n31\t    assert qtype == \"fill\" and mins == 2\n32\t\n33\t\n34\tdef test_short_answer_default() -> None:\n35\t    qtype, mins = atv.estimate_question_time(\"Explain briefly the concept.\")\n36\t    assert qtype == \"short\" and mins == 5\n37\t\n38\t\n39\tdef test_practical_time() -> None:\n40\t    qtype, mins = atv.estimate_question_time(\"Task 1: Perform the procedure\")\n41\t    assert qtype == \"practical\" and mins == 15\n42\t\n43\t\n44\tdef test_calculate_duration_ka(tmp_path: Path) -> None:\n45\t    ka = tmp_path / \"KA.md\"\n46\t    ka.write_text(\"# KA\\n**A1.** Q A) X\\n**A2.** Q A) Y\\n**Q3 (Scenario):** S\\n\", encoding=\"utf-8\")\n47\t    result = atv.calculate_assessment_duration(ka)\n48\t    assert result[\"question_count\"] == 3\n49\t    assert result[\"total_minutes\"] == 14  # 2+2+10\n50\t    assert result[\"assessment_type\"] == \"KA\""}]},"parent_tool_use_id":null,"session_id":"e8b3354b-5830-4547-91a0-f5b7d5e503e0","uuid":"04695cbd-8077-49d3-ae0b-ad75d22b7cb3","timestamp":"2026-04-17T10:32:01.682Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\tests\\test_assessment_timing.py","content":"\"\"\"Tests for assessment-time-validator.py.\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib.util\nimport sys\nimport tempfile\nfrom pathlib import Path\n\nspec = importlib.util.spec_from_file_location(\n    \"atv\", str(Path(__file__).resolve().parent.parent / \"_tools\" / \"assessment-time-validator.py\")\n)\nassert spec and spec.loader\natv = importlib.util.module_from_spec(spec)\nsys.modules[\"atv\"] = atv\nspec.loader.exec_module(atv)\n\n\ndef test_mcq_time() -> None:\n    qtype, mins = atv.estimate_question_time(\"**A1.** Which Act governs... A) X B) Y\")\n    assert qtype == \"mcq\" and mins == 2\n\n\ndef test_scenario_time() -> None:\n    qtype, mins = atv.estimate_question_time(\"**Q5 (Scenario):** A client presents...\")\n    assert qtype == \"scenario\" and mins == 10\n\n\ndef test_fill_blank_time() -> None:\n    qtype, mins = atv.estimate_question_time(\"The answer is ____________.\")\n    assert qtype == \"fill\" and mins == 2\n\n\ndef test_short_answer_default() -> None:\n    qtype, mins = atv.estimate_question_time(\"Explain briefly the concept.\")\n    assert qtype == \"short\" and mins == 5\n\n\ndef test_practical_time() -> None:\n    qtype, mins = atv.estimate_question_time(\"Task 1: Perform the procedure\")\n    assert qtype == \"practical\" and mins == 15\n\n\ndef test_calculate_duration_ka(tmp_path: Path) -> None:\n    ka = tmp_path / \"KA.md\"\n    ka.write_text(\"# KA\\n**A1.** Q A) X\\n**A2.** Q A) Y\\n**Q3 (Scenario):** S\\n\", encoding=\"utf-8\")\n    result = atv.calculate_assessment_duration(ka)\n    assert result[\"question_count\"] == 3\n    assert result[\"total_minutes\"] == 14  # 2+2+10\n    assert result[\"assessment_type\"] == \"KA\"","numLines":50,"startLine":1,"totalLines":69}}}
