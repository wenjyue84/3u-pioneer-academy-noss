{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V7fnN9T5Pu61puXHfYpNeG","type":"tool_result","content":"1\t\"\"\"Tests for NOSS CoCU Related Knowledge Dependency Mapper (US-033).\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport subprocess\n5\timport sys\n6\tfrom pathlib import Path\n7\t\n8\timport pytest\n9\t\n10\tROOT = Path(__file__).parents[1]\n11\tsys.path.insert(0, str(ROOT))\n12\t\n13\tfrom scripts.rk_parser import RKItem, parse_noss_extract  # noqa: E402\n14\tfrom scripts.validate_rk_coverage import SUBJECTS, build_coverage_report, scan_kp_files  # noqa: E402\n15\t\n16\tBEV_NOSS = ROOT / \"bev-diagnostic-rectification\" / \"00-noss-extract.md\"\n17\tAESTHETIC_NOSS = ROOT / \"aesthetic-services\" / \"00-noss-extract.md\"\n18\tIT_NOSS = ROOT / \"it-computer-system\" / \"00-noss-extract.md\"\n19\t\n20\t\n21\t# --- rk_parser unit tests ---\n22\t\n23\t\n24\tdef test_parse_bev_returns_rk_items() -> None:\n25\t    items = parse_noss_extract(BEV_NOSS, \"bev\")\n26\t    assert len(items) > 0\n27\t    codes = [i.code for i in items]\n28\t    assert \"1.1\" in codes\n29\t    assert \"2.1\" in codes\n30\t"}]},"parent_tool_use_id":null,"session_id":"41856400-6278-4fe8-b4e8-d6ce57744942","uuid":"02117801-8347-461b-8f72-f8d83c86f1ae","timestamp":"2026-04-17T03:57:37.218Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\tests\\test_rk_dependency_mapper.py","content":"\"\"\"Tests for NOSS CoCU Related Knowledge Dependency Mapper (US-033).\"\"\"\nfrom __future__ import annotations\n\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nimport pytest\n\nROOT = Path(__file__).parents[1]\nsys.path.insert(0, str(ROOT))\n\nfrom scripts.rk_parser import RKItem, parse_noss_extract  # noqa: E402\nfrom scripts.validate_rk_coverage import SUBJECTS, build_coverage_report, scan_kp_files  # noqa: E402\n\nBEV_NOSS = ROOT / \"bev-diagnostic-rectification\" / \"00-noss-extract.md\"\nAESTHETIC_NOSS = ROOT / \"aesthetic-services\" / \"00-noss-extract.md\"\nIT_NOSS = ROOT / \"it-computer-system\" / \"00-noss-extract.md\"\n\n\n# --- rk_parser unit tests ---\n\n\ndef test_parse_bev_returns_rk_items() -> None:\n    items = parse_noss_extract(BEV_NOSS, \"bev\")\n    assert len(items) > 0\n    codes = [i.code for i in items]\n    assert \"1.1\" in codes\n    assert \"2.1\" in codes\n","numLines":30,"startLine":1,"totalLines":137}}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01TBe1dPQQ9x48bYn9gwHQpA","type":"message","role":"assistant","content":[{"type":"text","text":"Now I have all the context I need. Let me plan.\n\n## Current State\n- IT-020 has 3 levels: L3 (7 CUs: C01-C07), L4 (6 CUs: C01-C06), L5 (7 CUs: C01-C07)\n- Only L3-C01 through L3-C04 have KA.md files; all other CU folders are empty\n- Existing KA files have structured questions with `### Q<N>` headings and `**Rubric:**` markers\n- Previous attempt produced 3414 lines — far over 500 limit\n\n## Problem Identified\nNeed a compact audit script that scans IT KA completeness across all levels, validates question count (min 12) and rubric presence, and outputs a completeness matrix — all under 500 diff lines.\n\n## Planned Changes\n- **Create** `scripts/audit_it_ka_completeness.py` (~80 lines) — minimal scanner with matrix output\n- **Create** `tests/test_it_ka_completeness_auditor.py` (~60 lines) — tests using subprocess pattern\n- **Modify** `prd.json` — mark US-034 passes: true\n\n<plan>\n{\n  \"files_to_create\": [\"scripts/audit_it_ka_completeness.py\", \"tests/test_it_ka_completeness_auditor.py\"],\n  \"files_to_modify\": [\"prd.json\"],\n  \"functions_to_add\": [\"audit_ka\", \"main\"],\n  \"estimated_loc\": 150\n}\n</plan>\n\nNow implementing — keeping everything extremely compact."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":521,"cache_read_input_tokens":39404,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":521},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"41856400-6278-4fe8-b4e8-d6ce57744942","uuid":"b4cbfb74-7fbb-43f9-af83-ae511f2fb583"}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01TBe1dPQQ9x48bYn9gwHQpA","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DZRAh1jKeFLrRoSzQmVgfY","name":"Write","input":{"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\scripts\\audit_it_ka_completeness.py","content":"\"\"\"IT-020 Knowledge Assessment Completeness Auditor.\n\nScans it-computer-system/L{3,4,5}/ directories, validates KA files exist per CU\nwith minimum 12 questions, answer scheme, and rubric (0-3 scale).\n\nUsage:\n    uv run python scripts/audit_it_ka_completeness.py [--root PATH] [--json]\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport re\nimport sys\nfrom pathlib import Path\n\nROOT = Path(__file__).parents[1]\nIT_DIR = \"it-computer-system\"\nLEVELS = {\"L3\": 7, \"L4\": 6, \"L5\": 7}\nMIN_QUESTIONS = 12\nRUBRIC_RE = re.compile(r\"\\*?\\*?Rubric\\*?\\*?:.*[0-3]\", re.IGNORECASE)\nQUESTION_RE = re.compile(r\"^#{1,4}\\s+Q\\d+\", re.MULTILINE)\nANSWER_RE = re.compile(r\"\\*?\\*?Answer\\*?\\*?:\", re.IGNORECASE)\n\n\ndef audit_ka(root: Path) -> dict[str, list[dict[str, object]]]:\n    \"\"\"Return {level: [{cu, path, exists, questions, has_rubric, has_answers}]}.\"\"\"\n    results: dict[str, list[dict[str, object]]] = {}\n    it_root = root / IT_DIR\n    for level, n_cus in LEVELS.items():\n        cus: list[dict[str, object]] = []\n        for i in range(1, n_cus + 1):\n            cu = f\"C{i:02d}\"\n            cu_dir = it_root / f\"{level}-{cu}\"\n            ka = cu_dir / \"KA.md\"\n            entry: dict[str, object] = {\"cu\": cu, \"path\": str(ka.relative_to(root)), \"exists\": False,\n                                        \"questions\": 0, \"has_rubric\": False, \"has_answers\": False}\n            if ka.is_file():\n                text = ka.read_text(encoding=\"utf-8\")\n                entry[\"exists\"] = True\n                entry[\"questions\"] = len(QUESTION_RE.findall(text))\n                entry[\"has_rubric\"] = bool(RUBRIC_RE.search(text))\n                entry[\"has_answers\"] = bool(ANSWER_RE.search(text))\n            cus.append(entry)\n        results[level] = cus\n    return results\n\n\ndef check_prd_hook(root: Path) -> list[str]:\n    \"\"\"Check prd.json for IT CUs without corresponding KA files.\"\"\"\n    prd = root / \"prd.json\"\n    if not prd.is_file():\n        return []\n    alerts: list[str] = []\n    data = json.loads(prd.read_text(encoding=\"utf-8\"))\n    for story in data.get(\"userStories\", []):\n        title = story.get(\"title\", \"\")\n        if \"IT\" in title and \"CU\" in title.upper():\n            m = re.search(r\"L(\\d)[- ]*C(\\d+)\", title, re.IGNORECASE)\n            if m:\n                ka = root / IT_DIR / f\"L{m.group(1)}-C{int(m.group(2)):02d}\" / \"KA.md\"\n                if not ka.is_file():\n                    alerts.append(f\"Story '{story['id']}' references {ka.name} but KA missing: {ka}\")\n    return alerts\n\n\ndef print_matrix(results: dict[str, list[dict[str, object]]]) -> None:\n    \"\"\"Print completeness matrix to stdout.\"\"\"\n    print(\"=\" * 60)\n    print(\"IT-020 KA COMPLETENESS AUDIT\")\n    print(\"=\" * 60)\n    for level, cus in results.items():\n        ok = sum(1 for c in cus if c[\"exists\"] and int(str(c[\"questions\"])) >= MIN_QUESTIONS\n                 and c[\"has_rubric\"] and c[\"has_answers\"])\n        print(f\"\\n{level}: {ok}/{len(cus)} complete\")\n        print(f\"  {'CU':<6} {'Exists':<8} {'Qs':<5} {'Rubric':<8} {'Answers':<8} {'Status'}\")\n        print(f\"  {'-'*6} {'-'*8} {'-'*5} {'-'*8} {'-'*8} {'-'*10}\")\n        for c in cus:\n            qs = int(str(c[\"questions\"]))\n            ok_flag = c[\"exists\"] and qs >= MIN_QUESTIONS and c[\"has_rubric\"] and c[\"has_answers\"]\n            status = \"OK\" if ok_flag else \"MISSING\" if not c[\"exists\"] else \"INCOMPLETE\"\n            print(f\"  {c['cu']:<6} {'Yes' if c['exists'] else 'No':<8} {qs:<5} \"\n                  f\"{'Yes' if c['has_rubric'] else 'No':<8} {'Yes' if c['has_answers'] else 'No':<8} {status}\")\n    # Remediation\n    missing = [(lv, c) for lv, cus in results.items() for c in cus\n               if not c[\"exists\"] or int(str(c[\"questions\"])) < MIN_QUESTIONS]\n    if missing:\n        print(f\"\\nREMEDIATION PLAN ({len(missing)} items):\")\n        for lv, c in missing:\n            effort = \"~2h (create from scratch)\" if not c[\"exists\"] else \"~1h (add questions)\"\n            print(f\"  {lv}-{c['cu']}: {c['path']} — {effort}\")\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=\"Audit IT-020 KA completeness\")\n    parser.add_argument(\"--root\", type=Path, default=ROOT)\n    parser.add_argument(\"--json\", action=\"store_true\", help=\"Output JSON instead of table\")\n    args = parser.parse_args()\n    results = audit_ka(args.root)\n    if args.json:\n        print(json.dumps(results, indent=2, ensure_ascii=False))\n    else:\n        print_matrix(results)\n        alerts = check_prd_hook(args.root)\n        if alerts:\n            print(\"\\nINTEGRATION ALERTS:\")\n            for a in alerts:\n                print(f\"  ⚠ {a}\")\n    # Exit 1 if any CU incomplete\n    all_ok = all(c[\"exists\"] and int(str(c[\"questions\"])) >= MIN_QUESTIONS\n                 and c[\"has_rubric\"] and c[\"has_answers\"]\n                 for cus in results.values() for c in cus)\n    sys.exit(0 if all_ok else 1)\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":521,"cache_read_input_tokens":39404,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":521},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"41856400-6278-4fe8-b4e8-d6ce57744942","uuid":"6e2df59e-01ce-4ca0-a799-ca4c2d541f70"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DZRAh1jKeFLrRoSzQmVgfY","type":"tool_result","content":"File created successfully at: C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\scripts\\audit_it_ka_completeness.py"}]},"parent_tool_use_id":null,"session_id":"41856400-6278-4fe8-b4e8-d6ce57744942","uuid":"e98ffd7e-db69-40a1-b656-92098f88310a","timestamp":"2026-04-17T03:58:13.306Z","tool_use_result":{"type":"create","filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\scripts\\audit_it_ka_completeness.py","content":"\"\"\"IT-020 Knowledge Assessment Completeness Auditor.\n\nScans it-computer-system/L{3,4,5}/ directories, validates KA files exist per CU\nwith minimum 12 questions, answer scheme, and rubric (0-3 scale).\n\nUsage:\n    uv run python scripts/audit_it_ka_completeness.py [--root PATH] [--json]\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport re\nimport sys\nfrom pathlib import Path\n\nROOT = Path(__file__).parents[1]\nIT_DIR = \"it-computer-system\"\nLEVELS = {\"L3\": 7, \"L4\": 6, \"L5\": 7}\nMIN_QUESTIONS = 12\nRUBRIC_RE = re.compile(r\"\\*?\\*?Rubric\\*?\\*?:.*[0-3]\", re.IGNORECASE)\nQUESTION_RE = re.compile(r\"^#{1,4}\\s+Q\\d+\", re.MULTILINE)\nANSWER_RE = re.compile(r\"\\*?\\*?Answer\\*?\\*?:\", re.IGNORECASE)\n\n\ndef audit_ka(root: Path) -> dict[str, list[dict[str, object]]]:\n    \"\"\"Return {level: [{cu, path, exists, questions, has_rubric, has_answers}]}.\"\"\"\n    results: dict[str, list[dict[str, object]]] = {}\n    it_root = root / IT_DIR\n    for level, n_cus in LEVELS.items():\n        cus: list[dict[str, object]] = []\n        for i in range(1, n_cus + 1):\n            cu = f\"C{i:02d}\"\n            cu_dir = it_root / f\"{level}-{cu}\"\n            ka = cu_dir / \"KA.md\"\n            entry: dict[str, object] = {\"cu\": cu, \"path\": str(ka.relative_to(root)), \"exists\": False,\n                                        \"questions\": 0, \"has_rubric\": False, \"has_answers\": False}\n            if ka.is_file():\n                text = ka.read_text(encoding=\"utf-8\")\n                entry[\"exists\"] = True\n                entry[\"questions\"] = len(QUESTION_RE.findall(text))\n                entry[\"has_rubric\"] = bool(RUBRIC_RE.search(text))\n                entry[\"has_answers\"] = bool(ANSWER_RE.search(text))\n            cus.append(entry)\n        results[level] = cus\n    return results\n\n\ndef check_prd_hook(root: Path) -> list[str]:\n    \"\"\"Check prd.json for IT CUs without corresponding KA files.\"\"\"\n    prd = root / \"prd.json\"\n    if not prd.is_file():\n        return []\n    alerts: list[str] = []\n    data = json.loads(prd.read_text(encoding=\"utf-8\"))\n    for story in data.get(\"userStories\", []):\n        title = story.get(\"title\", \"\")\n        if \"IT\" in title and \"CU\" in title.upper():\n            m = re.search(r\"L(\\d)[- ]*C(\\d+)\", title, re.IGNORECASE)\n            if m:\n                ka = root / IT_DIR / f\"L{m.group(1)}-C{int(m.group(2)):02d}\" / \"KA.md\"\n                if not ka.is_file():\n                    alerts.append(f\"Story '{story['id']}' references {ka.name} but KA missing: {ka}\")\n    return alerts\n\n\ndef print_matrix(results: dict[str, list[dict[str, object]]]) -> None:\n    \"\"\"Print completeness matrix to stdout.\"\"\"\n    print(\"=\" * 60)\n    print(\"IT-020 KA COMPLETENESS AUDIT\")\n    print(\"=\" * 60)\n    for level, cus in results.items():\n        ok = sum(1 for c in cus if c[\"exists\"] and int(str(c[\"questions\"])) >= MIN_QUESTIONS\n                 and c[\"has_rubric\"] and c[\"has_answers\"])\n        print(f\"\\n{level}: {ok}/{len(cus)} complete\")\n        print(f\"  {'CU':<6} {'Exists':<8} {'Qs':<5} {'Rubric':<8} {'Answers':<8} {'Status'}\")\n        print(f\"  {'-'*6} {'-'*8} {'-'*5} {'-'*8} {'-'*8} {'-'*10}\")\n        for c in cus:\n            qs = int(str(c[\"questions\"]))\n            ok_flag = c[\"exists\"] and qs >= MIN_QUESTIONS and c[\"has_rubric\"] and c[\"has_answers\"]\n            status = \"OK\" if ok_flag else \"MISSING\" if not c[\"exists\"] else \"INCOMPLETE\"\n            print(f\"  {c['cu']:<6} {'Yes' if c['exists'] else 'No':<8} {qs:<5} \"\n                  f\"{'Yes' if c['has_rubric'] else 'No':<8} {'Yes' if c['has_answers'] else 'No':<8} {status}\")\n    # Remediation\n    missing = [(lv, c) for lv, cus in results.items() for c in cus\n               if not c[\"exists\"] or int(str(c[\"questions\"])) < MIN_QUESTIONS]\n    if missing:\n        print(f\"\\nREMEDIATION PLAN ({len(missing)} items):\")\n        for lv, c in missing:\n            effort = \"~2h (create from scratch)\" if not c[\"exists\"] else \"~1h (add questions)\"\n            print(f\"  {lv}-{c['cu']}: {c['path']} — {effort}\")\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=\"Audit IT-020 KA completeness\")\n    parser.add_argument(\"--root\", type=Path, default=ROOT)\n    parser.add_argument(\"--json\", action=\"store_true\", help=\"Output JSON instead of table\")\n    args = parser.parse_args()\n    results = audit_ka(args.root)\n    if args.json:\n        print(json.dumps(results, indent=2, ensure_ascii=False))\n    else:\n        print_matrix(results)\n        alerts = check_prd_hook(args.root)\n        if alerts:\n            print(\"\\nINTEGRATION ALERTS:\")\n            for a in alerts:\n                print(f\"  ⚠ {a}\")\n    # Exit 1 if any CU incomplete\n    all_ok = all(c[\"exists\"] and int(str(c[\"questions\"])) >= MIN_QUESTIONS\n                 and c[\"has_rubric\"] and c[\"has_answers\"]\n                 for cus in results.values() for c in cus)\n    sys.exit(0 if all_ok else 1)\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[],"originalFile":null}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_019nL5RixvW4JGL3XNsrZ8Y1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014tgPdPzi66GtCQKH6artEF","name":"Write","input":{"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\tests\\test_it_ka_completeness_auditor.py","content":"\"\"\"Tests for IT-020 KA Completeness Auditor (US-034).\"\"\"\nfrom __future__ import annotations\n\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nimport pytest\n\nROOT = Path(__file__).parents[1]\nSCRIPT = ROOT / \"scripts\" / \"audit_it_ka_completeness.py\"\n\n\ndef _run(*extra: str) -> subprocess.CompletedProcess[str]:\n    return subprocess.run(\n        [sys.executable, str(SCRIPT), \"--root\", str(ROOT), *extra],\n        capture_output=True, text=True, encoding=\"utf-8\",\n    )\n\n\ndef test_script_runs_without_crash() -> None:\n    r = _run()\n    assert r.returncode in (0, 1), f\"Unexpected crash:\\n{r.stderr}\"\n    assert \"KA COMPLETENESS AUDIT\" in r.stdout\n\n\ndef test_matrix_shows_all_levels() -> None:\n    r = _run()\n    for level in (\"L3:\", \"L4:\", \"L5:\"):\n        assert level in r.stdout, f\"{level} missing from matrix\"\n\n\ndef test_detects_existing_ka_files() -> None:\n    r = _run()\n    assert \"C01\" in r.stdout\n    lines = [ln for ln in r.stdout.splitlines() if \"C01\" in ln and \"Yes\" in ln]\n    assert len(lines) >= 1, \"L3-C01 KA should be detected as existing\"\n\n\ndef test_reports_missing_ka() -> None:\n    r = _run()\n    assert \"MISSING\" in r.stdout or \"INCOMPLETE\" in r.stdout, \"Should flag missing/incomplete KAs\"\n\n\ndef test_remediation_plan_present() -> None:\n    r = _run()\n    assert \"REMEDIATION\" in r.stdout, \"Should include remediation plan\"\n\n\ndef test_json_output() -> None:\n    r = _run(\"--json\")\n    import json\n    data = json.loads(r.stdout)\n    assert \"L3\" in data\n    assert \"L4\" in data\n    assert \"L5\" in data\n    assert len(data[\"L3\"]) == 7\n    assert len(data[\"L4\"]) == 6\n    assert len(data[\"L5\"]) == 7\n\n\ndef test_ka_validation_fields() -> None:\n    r = _run(\"--json\")\n    import json\n    data = json.loads(r.stdout)\n    c01 = data[\"L3\"][0]\n    assert c01[\"cu\"] == \"C01\"\n    assert c01[\"exists\"] is True\n    assert isinstance(c01[\"questions\"], int)\n    assert \"has_rubric\" in c01\n    assert \"has_answers\" in c01\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2292,"cache_read_input_tokens":39925,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2292},"output_tokens":73,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"41856400-6278-4fe8-b4e8-d6ce57744942","uuid":"b0003bdc-23ef-4aa9-a360-15d0cb8a7b05"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014tgPdPzi66GtCQKH6artEF","type":"tool_result","content":"File created successfully at: C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\tests\\test_it_ka_completeness_auditor.py"}]},"parent_tool_use_id":null,"session_id":"41856400-6278-4fe8-b4e8-d6ce57744942","uuid":"a95701f0-a2ff-42e6-bd21-0441c878a120","timestamp":"2026-04-17T03:58:26.060Z","tool_use_result":{"type":"create","filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\tests\\test_it_ka_completeness_auditor.py","content":"\"\"\"Tests for IT-020 KA Completeness Auditor (US-034).\"\"\"\nfrom __future__ import annotations\n\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nimport pytest\n\nROOT = Path(__file__).parents[1]\nSCRIPT = ROOT / \"scripts\" / \"audit_it_ka_completeness.py\"\n\n\ndef _run(*extra: str) -> subprocess.CompletedProcess[str]:\n    return subprocess.run(\n        [sys.executable, str(SCRIPT), \"--root\", str(ROOT), *extra],\n        capture_output=True, text=True, encoding=\"utf-8\",\n    )\n\n\ndef test_script_runs_without_crash() -> None:\n    r = _run()\n    assert r.returncode in (0, 1), f\"Unexpected crash:\\n{r.stderr}\"\n    assert \"KA COMPLETENESS AUDIT\" in r.stdout\n\n\ndef test_matrix_shows_all_levels() -> None:\n    r = _run()\n    for level in (\"L3:\", \"L4:\", \"L5:\"):\n        assert level in r.stdout, f\"{level} missing from matrix\"\n\n\ndef test_detects_existing_ka_files() -> None:\n    r = _run()\n    assert \"C01\" in r.stdout\n    lines = [ln for ln in r.stdout.splitlines() if \"C01\" in ln and \"Yes\" in ln]\n    assert len(lines) >= 1, \"L3-C01 KA should be detected as existing\"\n\n\ndef test_reports_missing_ka() -> None:\n    r = _run()\n    assert \"MISSING\" in r.stdout or \"INCOMPLETE\" in r.stdout, \"Should flag missing/incomplete KAs\"\n\n\ndef test_remediation_plan_present() -> None:\n    r = _run()\n    assert \"REMEDIATION\" in r.stdout, \"Should include remediation plan\"\n\n\ndef test_json_output() -> None:\n    r = _run(\"--json\")\n    import json\n    data = json.loads(r.stdout)\n    assert \"L3\" in data\n    assert \"L4\" in data\n    assert \"L5\" in data\n    assert len(data[\"L3\"]) == 7\n    assert len(data[\"L4\"]) == 6\n    assert len(data[\"L5\"]) == 7\n\n\ndef test_ka_validation_fields() -> None:\n    r = _run(\"--json\")\n    import json\n    data = json.loads(r.stdout)\n    c01 = data[\"L3\"][0]\n    assert c01[\"cu\"] == \"C01\"\n    assert c01[\"exists\"] is True\n    assert isinstance(c01[\"questions\"], int)\n    assert \"has_rubric\" in c01\n    assert \"has_answers\" in c01\n","structuredPatch":[],"originalFile":null}}
