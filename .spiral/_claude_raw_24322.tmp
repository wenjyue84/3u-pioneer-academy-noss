{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FRxL2ch2TN7j4LWxHpcuqP","type":"tool_result","content":"1\t\"\"\"IT-020 Knowledge Assessment Completeness Auditor.\n2\t\n3\tScans it-computer-system/L{3,4,5}/ directories, validates KA files exist per CU\n4\twith minimum 12 questions, answer scheme, and rubric (0-3 scale).\n5\t\n6\tUsage:\n7\t    uv run python scripts/audit_it_ka_completeness.py [--root PATH] [--json]\n8\t\"\"\"\n9\tfrom __future__ import annotations\n10\t\n11\timport argparse\n12\timport json\n13\timport re\n14\timport sys\n15\tfrom pathlib import Path\n16\t\n17\tROOT = Path(__file__).parents[1]\n18\tIT_DIR = \"it-computer-system\"\n19\tLEVELS = {\"L3\": 7, \"L4\": 6, \"L5\": 7}\n20\tMIN_QUESTIONS = 12\n21\tRUBRIC_RE = re.compile(r\"\\*?\\*?Rubric\\*?\\*?:.*[0-3]\", re.IGNORECASE)\n22\tQUESTION_RE = re.compile(r\"^#{1,4}\\s+Q\\d+\", re.MULTILINE)\n23\tANSWER_RE = re.compile(r\"\\*?\\*?Answer\\*?\\*?:\", re.IGNORECASE)\n24\t\n25\t\n26\tdef audit_ka(root: Path) -> dict[str, list[dict[str, object]]]:\n27\t    \"\"\"Return {level: [{cu, path, exists, questions, has_rubric, has_answers}]}.\"\"\"\n28\t    results: dict[str, list[dict[str, object]]] = {}\n29\t    it_root = root / IT_DIR\n30\t    for level, n_cus in LEVELS.items():\n31\t        cus: list[dict[str, object]] = []\n32\t        for i in range(1, n_cus + 1):\n33\t            cu = f\"C{i:02d}\"\n34\t            cu_dir = it_root / f\"{level}-{cu}\"\n35\t            ka = cu_dir / \"KA.md\"\n36\t            entry: dict[str, object] = {\"cu\": cu, \"path\": str(ka.relative_to(root)), \"exists\": False,\n37\t                                        \"questions\": 0, \"has_rubric\": False, \"has_answers\": False}\n38\t            if ka.is_file():\n39\t                text = ka.read_text(encoding=\"utf-8\")\n40\t                entry[\"exists\"] = True\n41\t                entry[\"questions\"] = len(QUESTION_RE.findall(text))\n42\t                entry[\"has_rubric\"] = bool(RUBRIC_RE.search(text))\n43\t                entry[\"has_answers\"] = bool(ANSWER_RE.search(text))\n44\t            cus.append(entry)\n45\t        results[level] = cus\n46\t    return results\n47\t\n48\t\n49\tdef check_prd_hook(root: Path) -> list[str]:\n50\t    \"\"\"Check prd.json for IT CUs without corresponding KA files.\"\"\"\n51\t    prd = root / \"prd.json\"\n52\t    if not prd.is_file():\n53\t        return []\n54\t    alerts: list[str] = []\n55\t    data = json.loads(prd.read_text(encoding=\"utf-8\"))\n56\t    for story in data.get(\"userStories\", []):\n57\t        title = story.get(\"title\", \"\")\n58\t        if \"IT\" in title and \"CU\" in title.upper():\n59\t            m = re.search(r\"L(\\d)[- ]*C(\\d+)\", title, re.IGNORECASE)\n60\t            if m:\n61\t                ka = root / IT_DIR / f\"L{m.group(1)}-C{int(m.group(2)):02d}\" / \"KA.md\"\n62\t                if not ka.is_file():\n63\t                    alerts.append(f\"Story '{story['id']}' references {ka.name} but KA missing: {ka}\")\n64\t    return alerts\n65\t\n66\t\n67\tdef print_matrix(results: dict[str, list[dict[str, object]]]) -> None:\n68\t    \"\"\"Print completeness matrix to stdout.\"\"\"\n69\t    print(\"=\" * 60)\n70\t    print(\"IT-020 KA COMPLETENESS AUDIT\")\n71\t    print(\"=\" * 60)\n72\t    for level, cus in results.items():\n73\t        ok = sum(1 for c in cus if c[\"exists\"] and int(str(c[\"questions\"])) >= MIN_QUESTIONS\n74\t                 and c[\"has_rubric\"] and c[\"has_answers\"])\n75\t        print(f\"\\n{level}: {ok}/{len(cus)} complete\")\n76\t        print(f\"  {'CU':<6} {'Exists':<8} {'Qs':<5} {'Rubric':<8} {'Answers':<8} {'Status'}\")\n77\t        print(f\"  {'-'*6} {'-'*8} {'-'*5} {'-'*8} {'-'*8} {'-'*10}\")\n78\t        for c in cus:\n79\t            qs = int(str(c[\"questions\"]))\n80\t            ok_flag = c[\"exists\"] and qs >= MIN_QUESTIONS and c[\"has_rubric\"] and c[\"has_answers\"]\n81\t            status = \"OK\" if ok_flag else \"MISSING\" if not c[\"exists\"] else \"INCOMPLETE\"\n82\t            print(f\"  {c['cu']:<6} {'Yes' if c['exists'] else 'No':<8} {qs:<5} \"\n83\t                  f\"{'Yes' if c['has_rubric'] else 'No':<8} {'Yes' if c['has_answers'] else 'No':<8} {status}\")\n84\t    # Remediation\n85\t    missing = [(lv, c) for lv, cus in results.items() for c in cus\n86\t               if not c[\"exists\"] or int(str(c[\"questions\"])) < MIN_QUESTIONS]\n87\t    if missing:\n88\t        print(f\"\\nREMEDIATION PLAN ({len(missing)} items):\")\n89\t        for lv, c in missing:\n90\t            effort = \"~2h (create from scratch)\" if not c[\"exists\"] else \"~1h (add questions)\"\n91\t            print(f\"  {lv}-{c['cu']}: {c['path']} — {effort}\")\n92\t\n93\t\n94\tdef main() -> None:\n95\t    parser = argparse.ArgumentParser(description=\"Audit IT-020 KA completeness\")\n96\t    parser.add_argument(\"--root\", type=Path, default=ROOT)\n97\t    parser.add_argument(\"--json\", action=\"store_true\", help=\"Output JSON instead of table\")\n98\t    args = parser.parse_args()\n99\t    results = audit_ka(args.root)\n100\t    if args.json:\n101\t        print(json.dumps(results, indent=2, ensure_ascii=False))\n102\t    else:\n103\t        print_matrix(results)\n104\t        alerts = check_prd_hook(args.root)\n105\t        if alerts:\n106\t            print(\"\\nINTEGRATION ALERTS:\")\n107\t            for a in alerts:\n108\t                print(f\"  ⚠ {a}\")\n109\t    # Exit 1 if any CU incomplete\n110\t    all_ok = all(c[\"exists\"] and int(str(c[\"questions\"])) >= MIN_QUESTIONS\n111\t                 and c[\"has_rubric\"] and c[\"has_answers\"]\n112\t                 for cus in results.values() for c in cus)\n113\t    sys.exit(0 if all_ok else 1)\n114\t\n115\t\n116\tif __name__ == \"__main__\":\n117\t    main()\n118\t"}]},"parent_tool_use_id":null,"session_id":"41856400-6278-4fe8-b4e8-d6ce57744942","uuid":"7fd8e4b8-d13c-4246-8437-b616e3d112d3","timestamp":"2026-04-17T03:59:00.594Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\scripts\\audit_it_ka_completeness.py","content":"\"\"\"IT-020 Knowledge Assessment Completeness Auditor.\n\nScans it-computer-system/L{3,4,5}/ directories, validates KA files exist per CU\nwith minimum 12 questions, answer scheme, and rubric (0-3 scale).\n\nUsage:\n    uv run python scripts/audit_it_ka_completeness.py [--root PATH] [--json]\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport re\nimport sys\nfrom pathlib import Path\n\nROOT = Path(__file__).parents[1]\nIT_DIR = \"it-computer-system\"\nLEVELS = {\"L3\": 7, \"L4\": 6, \"L5\": 7}\nMIN_QUESTIONS = 12\nRUBRIC_RE = re.compile(r\"\\*?\\*?Rubric\\*?\\*?:.*[0-3]\", re.IGNORECASE)\nQUESTION_RE = re.compile(r\"^#{1,4}\\s+Q\\d+\", re.MULTILINE)\nANSWER_RE = re.compile(r\"\\*?\\*?Answer\\*?\\*?:\", re.IGNORECASE)\n\n\ndef audit_ka(root: Path) -> dict[str, list[dict[str, object]]]:\n    \"\"\"Return {level: [{cu, path, exists, questions, has_rubric, has_answers}]}.\"\"\"\n    results: dict[str, list[dict[str, object]]] = {}\n    it_root = root / IT_DIR\n    for level, n_cus in LEVELS.items():\n        cus: list[dict[str, object]] = []\n        for i in range(1, n_cus + 1):\n            cu = f\"C{i:02d}\"\n            cu_dir = it_root / f\"{level}-{cu}\"\n            ka = cu_dir / \"KA.md\"\n            entry: dict[str, object] = {\"cu\": cu, \"path\": str(ka.relative_to(root)), \"exists\": False,\n                                        \"questions\": 0, \"has_rubric\": False, \"has_answers\": False}\n            if ka.is_file():\n                text = ka.read_text(encoding=\"utf-8\")\n                entry[\"exists\"] = True\n                entry[\"questions\"] = len(QUESTION_RE.findall(text))\n                entry[\"has_rubric\"] = bool(RUBRIC_RE.search(text))\n                entry[\"has_answers\"] = bool(ANSWER_RE.search(text))\n            cus.append(entry)\n        results[level] = cus\n    return results\n\n\ndef check_prd_hook(root: Path) -> list[str]:\n    \"\"\"Check prd.json for IT CUs without corresponding KA files.\"\"\"\n    prd = root / \"prd.json\"\n    if not prd.is_file():\n        return []\n    alerts: list[str] = []\n    data = json.loads(prd.read_text(encoding=\"utf-8\"))\n    for story in data.get(\"userStories\", []):\n        title = story.get(\"title\", \"\")\n        if \"IT\" in title and \"CU\" in title.upper():\n            m = re.search(r\"L(\\d)[- ]*C(\\d+)\", title, re.IGNORECASE)\n            if m:\n                ka = root / IT_DIR / f\"L{m.group(1)}-C{int(m.group(2)):02d}\" / \"KA.md\"\n                if not ka.is_file():\n                    alerts.append(f\"Story '{story['id']}' references {ka.name} but KA missing: {ka}\")\n    return alerts\n\n\ndef print_matrix(results: dict[str, list[dict[str, object]]]) -> None:\n    \"\"\"Print completeness matrix to stdout.\"\"\"\n    print(\"=\" * 60)\n    print(\"IT-020 KA COMPLETENESS AUDIT\")\n    print(\"=\" * 60)\n    for level, cus in results.items():\n        ok = sum(1 for c in cus if c[\"exists\"] and int(str(c[\"questions\"])) >= MIN_QUESTIONS\n                 and c[\"has_rubric\"] and c[\"has_answers\"])\n        print(f\"\\n{level}: {ok}/{len(cus)} complete\")\n        print(f\"  {'CU':<6} {'Exists':<8} {'Qs':<5} {'Rubric':<8} {'Answers':<8} {'Status'}\")\n        print(f\"  {'-'*6} {'-'*8} {'-'*5} {'-'*8} {'-'*8} {'-'*10}\")\n        for c in cus:\n            qs = int(str(c[\"questions\"]))\n            ok_flag = c[\"exists\"] and qs >= MIN_QUESTIONS and c[\"has_rubric\"] and c[\"has_answers\"]\n            status = \"OK\" if ok_flag else \"MISSING\" if not c[\"exists\"] else \"INCOMPLETE\"\n            print(f\"  {c['cu']:<6} {'Yes' if c['exists'] else 'No':<8} {qs:<5} \"\n                  f\"{'Yes' if c['has_rubric'] else 'No':<8} {'Yes' if c['has_answers'] else 'No':<8} {status}\")\n    # Remediation\n    missing = [(lv, c) for lv, cus in results.items() for c in cus\n               if not c[\"exists\"] or int(str(c[\"questions\"])) < MIN_QUESTIONS]\n    if missing:\n        print(f\"\\nREMEDIATION PLAN ({len(missing)} items):\")\n        for lv, c in missing:\n            effort = \"~2h (create from scratch)\" if not c[\"exists\"] else \"~1h (add questions)\"\n            print(f\"  {lv}-{c['cu']}: {c['path']} — {effort}\")\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=\"Audit IT-020 KA completeness\")\n    parser.add_argument(\"--root\", type=Path, default=ROOT)\n    parser.add_argument(\"--json\", action=\"store_true\", help=\"Output JSON instead of table\")\n    args = parser.parse_args()\n    results = audit_ka(args.root)\n    if args.json:\n        print(json.dumps(results, indent=2, ensure_ascii=False))\n    else:\n        print_matrix(results)\n        alerts = check_prd_hook(args.root)\n        if alerts:\n            print(\"\\nINTEGRATION ALERTS:\")\n            for a in alerts:\n                print(f\"  ⚠ {a}\")\n    # Exit 1 if any CU incomplete\n    all_ok = all(c[\"exists\"] and int(str(c[\"questions\"])) >= MIN_QUESTIONS\n                 and c[\"has_rubric\"] and c[\"has_answers\"]\n                 for cus in results.values() for c in cus)\n    sys.exit(0 if all_ok else 1)\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":118,"startLine":1,"totalLines":118}}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01QuCWgUxuQ1tGJ1fAoW4PrL","type":"message","role":"assistant","content":[{"type":"text","text":"I need to update the regexes to handle both KA formats. C01 uses `**1.**` numbered questions, C02-C04 use `### Q1` headings. Also C01 uses \"answer scheme\" rather than inline answers."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2140,"cache_read_input_tokens":45618,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2140},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"41856400-6278-4fe8-b4e8-d6ce57744942","uuid":"dbb61802-b2c0-4955-94c2-930331f8a46f"}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01QuCWgUxuQ1tGJ1fAoW4PrL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018pzkDo6GGiegyNWo89CgRB","name":"Edit","input":{"replace_all":false,"file_path":"C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\scripts\\audit_it_ka_completeness.py","old_string":"RUBRIC_RE = re.compile(r\"\\*?\\*?Rubric\\*?\\*?:.*[0-3]\", re.IGNORECASE)\nQUESTION_RE = re.compile(r\"^#{1,4}\\s+Q\\d+\", re.MULTILINE)\nANSWER_RE = re.compile(r\"\\*?\\*?Answer\\*?\\*?:\", re.IGNORECASE)","new_string":"RUBRIC_RE = re.compile(r\"Rubric|marking scheme|answer scheme\", re.IGNORECASE)\n# Matches \"### Q1\", \"**1.**\", \"**2.**\" etc.\nQUESTION_RE = re.compile(r\"^#{1,4}\\s+Q\\d+|^\\*\\*\\d+\\.\\*\\*\", re.MULTILINE)\nANSWER_RE = re.compile(r\"\\*?\\*?Answer\\*?\\*?:|answer scheme|Model Answer\", re.IGNORECASE)"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2140,"cache_read_input_tokens":45618,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2140},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"41856400-6278-4fe8-b4e8-d6ce57744942","uuid":"d053b922-e47c-461d-8613-1ad662864979"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018pzkDo6GGiegyNWo89CgRB","type":"tool_result","content":"The file C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\scripts\\audit_it_ka_completeness.py has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"41856400-6278-4fe8-b4e8-d6ce57744942","uuid":"2cdfaa37-ccba-4c08-9737-9395cd7e6101","timestamp":"2026-04-17T03:59:10.116Z","tool_use_result":{"filePath":"C:\\Users\\Jyue\\Documents\\1-projects\\noss-to-wim\\scripts\\audit_it_ka_completeness.py","oldString":"RUBRIC_RE = re.compile(r\"\\*?\\*?Rubric\\*?\\*?:.*[0-3]\", re.IGNORECASE)\nQUESTION_RE = re.compile(r\"^#{1,4}\\s+Q\\d+\", re.MULTILINE)\nANSWER_RE = re.compile(r\"\\*?\\*?Answer\\*?\\*?:\", re.IGNORECASE)","newString":"RUBRIC_RE = re.compile(r\"Rubric|marking scheme|answer scheme\", re.IGNORECASE)\n# Matches \"### Q1\", \"**1.**\", \"**2.**\" etc.\nQUESTION_RE = re.compile(r\"^#{1,4}\\s+Q\\d+|^\\*\\*\\d+\\.\\*\\*\", re.MULTILINE)\nANSWER_RE = re.compile(r\"\\*?\\*?Answer\\*?\\*?:|answer scheme|Model Answer\", re.IGNORECASE)","originalFile":"\"\"\"IT-020 Knowledge Assessment Completeness Auditor.\n\nScans it-computer-system/L{3,4,5}/ directories, validates KA files exist per CU\nwith minimum 12 questions, answer scheme, and rubric (0-3 scale).\n\nUsage:\n    uv run python scripts/audit_it_ka_completeness.py [--root PATH] [--json]\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport re\nimport sys\nfrom pathlib import Path\n\nROOT = Path(__file__).parents[1]\nIT_DIR = \"it-computer-system\"\nLEVELS = {\"L3\": 7, \"L4\": 6, \"L5\": 7}\nMIN_QUESTIONS = 12\nRUBRIC_RE = re.compile(r\"\\*?\\*?Rubric\\*?\\*?:.*[0-3]\", re.IGNORECASE)\nQUESTION_RE = re.compile(r\"^#{1,4}\\s+Q\\d+\", re.MULTILINE)\nANSWER_RE = re.compile(r\"\\*?\\*?Answer\\*?\\*?:\", re.IGNORECASE)\n\n\ndef audit_ka(root: Path) -> dict[str, list[dict[str, object]]]:\n    \"\"\"Return {level: [{cu, path, exists, questions, has_rubric, has_answers}]}.\"\"\"\n    results: dict[str, list[dict[str, object]]] = {}\n    it_root = root / IT_DIR\n    for level, n_cus in LEVELS.items():\n        cus: list[dict[str, object]] = []\n        for i in range(1, n_cus + 1):\n            cu = f\"C{i:02d}\"\n            cu_dir = it_root / f\"{level}-{cu}\"\n            ka = cu_dir / \"KA.md\"\n            entry: dict[str, object] = {\"cu\": cu, \"path\": str(ka.relative_to(root)), \"exists\": False,\n                                        \"questions\": 0, \"has_rubric\": False, \"has_answers\": False}\n            if ka.is_file():\n                text = ka.read_text(encoding=\"utf-8\")\n                entry[\"exists\"] = True\n                entry[\"questions\"] = len(QUESTION_RE.findall(text))\n                entry[\"has_rubric\"] = bool(RUBRIC_RE.search(text))\n                entry[\"has_answers\"] = bool(ANSWER_RE.search(text))\n            cus.append(entry)\n        results[level] = cus\n    return results\n\n\ndef check_prd_hook(root: Path) -> list[str]:\n    \"\"\"Check prd.json for IT CUs without corresponding KA files.\"\"\"\n    prd = root / \"prd.json\"\n    if not prd.is_file():\n        return []\n    alerts: list[str] = []\n    data = json.loads(prd.read_text(encoding=\"utf-8\"))\n    for story in data.get(\"userStories\", []):\n        title = story.get(\"title\", \"\")\n        if \"IT\" in title and \"CU\" in title.upper():\n            m = re.search(r\"L(\\d)[- ]*C(\\d+)\", title, re.IGNORECASE)\n            if m:\n                ka = root / IT_DIR / f\"L{m.group(1)}-C{int(m.group(2)):02d}\" / \"KA.md\"\n                if not ka.is_file():\n                    alerts.append(f\"Story '{story['id']}' references {ka.name} but KA missing: {ka}\")\n    return alerts\n\n\ndef print_matrix(results: dict[str, list[dict[str, object]]]) -> None:\n    \"\"\"Print completeness matrix to stdout.\"\"\"\n    print(\"=\" * 60)\n    print(\"IT-020 KA COMPLETENESS AUDIT\")\n    print(\"=\" * 60)\n    for level, cus in results.items():\n        ok = sum(1 for c in cus if c[\"exists\"] and int(str(c[\"questions\"])) >= MIN_QUESTIONS\n                 and c[\"has_rubric\"] and c[\"has_answers\"])\n        print(f\"\\n{level}: {ok}/{len(cus)} complete\")\n        print(f\"  {'CU':<6} {'Exists':<8} {'Qs':<5} {'Rubric':<8} {'Answers':<8} {'Status'}\")\n        print(f\"  {'-'*6} {'-'*8} {'-'*5} {'-'*8} {'-'*8} {'-'*10}\")\n        for c in cus:\n            qs = int(str(c[\"questions\"]))\n            ok_flag = c[\"exists\"] and qs >= MIN_QUESTIONS and c[\"has_rubric\"] and c[\"has_answers\"]\n            status = \"OK\" if ok_flag else \"MISSING\" if not c[\"exists\"] else \"INCOMPLETE\"\n            print(f\"  {c['cu']:<6} {'Yes' if c['exists'] else 'No':<8} {qs:<5} \"\n                  f\"{'Yes' if c['has_rubric'] else 'No':<8} {'Yes' if c['has_answers'] else 'No':<8} {status}\")\n    # Remediation\n    missing = [(lv, c) for lv, cus in results.items() for c in cus\n               if not c[\"exists\"] or int(str(c[\"questions\"])) < MIN_QUESTIONS]\n    if missing:\n        print(f\"\\nREMEDIATION PLAN ({len(missing)} items):\")\n        for lv, c in missing:\n            effort = \"~2h (create from scratch)\" if not c[\"exists\"] else \"~1h (add questions)\"\n            print(f\"  {lv}-{c['cu']}: {c['path']} — {effort}\")\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=\"Audit IT-020 KA completeness\")\n    parser.add_argument(\"--root\", type=Path, default=ROOT)\n    parser.add_argument(\"--json\", action=\"store_true\", help=\"Output JSON instead of table\")\n    args = parser.parse_args()\n    results = audit_ka(args.root)\n    if args.json:\n        print(json.dumps(results, indent=2, ensure_ascii=False))\n    else:\n        print_matrix(results)\n        alerts = check_prd_hook(args.root)\n        if alerts:\n            print(\"\\nINTEGRATION ALERTS:\")\n            for a in alerts:\n                print(f\"  ⚠ {a}\")\n    # Exit 1 if any CU incomplete\n    all_ok = all(c[\"exists\"] and int(str(c[\"questions\"])) >= MIN_QUESTIONS\n                 and c[\"has_rubric\"] and c[\"has_answers\"]\n                 for cus in results.values() for c in cus)\n    sys.exit(0 if all_ok else 1)\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[{"oldStart":18,"oldLines":9,"newStart":18,"newLines":10,"lines":[" IT_DIR = \"it-computer-system\""," LEVELS = {\"L3\": 7, \"L4\": 6, \"L5\": 7}"," MIN_QUESTIONS = 12","-RUBRIC_RE = re.compile(r\"\\*?\\*?Rubric\\*?\\*?:.*[0-3]\", re.IGNORECASE)","-QUESTION_RE = re.compile(r\"^#{1,4}\\s+Q\\d+\", re.MULTILINE)","-ANSWER_RE = re.compile(r\"\\*?\\*?Answer\\*?\\*?:\", re.IGNORECASE)","+RUBRIC_RE = re.compile(r\"Rubric|marking scheme|answer scheme\", re.IGNORECASE)","+# Matches \"### Q1\", \"**1.**\", \"**2.**\" etc.","+QUESTION_RE = re.compile(r\"^#{1,4}\\s+Q\\d+|^\\*\\*\\d+\\.\\*\\*\", re.MULTILINE)","+ANSWER_RE = re.compile(r\"\\*?\\*?Answer\\*?\\*?:|answer scheme|Model Answer\", re.IGNORECASE)"," "," "," def audit_ka(root: Path) -> dict[str, list[dict[str, object]]]:"]}],"userModified":false,"replaceAll":false}}
